{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "garment.schema.json",
  "title": "Garment",
  "description": "One clothing item or accessory. Opus-owned.",
  "type": "object",
  "required": ["id", "label", "category", "strategy", "views", "material"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9_]+$", "description": "e.g. 'boots_01'" },
    "label": { "type": "string", "description": "Human-readable, e.g. 'black knee boots'" },
    "category": {
      "enum": [
        "bodysuit", "top", "bra", "jacket", "coat", "dress", "skirt", "shorts",
        "trousers", "leggings", "stockings", "underwear", "gloves", "boots", "shoes",
        "hat", "belt", "collar", "harness", "jewellery", "glasses", "accessory", "other"
      ]
    },
    "strategy": { "enum": ["skin_layer", "template", "generated"] },
    "layer": {
      "type": "integer", "minimum": 0, "maximum": 5,
      "description": "0 = closest to skin. Used for draw order and anti-clipping."
    },
    "views": { "type": "array", "items": { "enum": ["front", "back", "left", "right"] }, "minItems": 1 },
    "masks": {
      "type": "object",
      "description": "view -> mask path relative to job_dir",
      "additionalProperties": { "type": "string" }
    },
    "template_id": { "type": ["string", "null"], "description": "garment library id when strategy = template" },
    "material": {
      "type": "object",
      "required": ["type", "color"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["fabric", "knit", "denim", "leather", "latex", "lace", "mesh", "metal", "plastic", "other"] },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "roughness": { "type": "number", "minimum": 0, "maximum": 1 },
        "metallic": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "mesh": { "type": ["string", "null"], "description": "path to raw/fitted mesh relative to job_dir" },
    "textures": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "basecolor": { "type": "string" },
        "normal": { "type": "string" },
        "roughness": { "type": "string" },
        "metallic": { "type": "string" }
      }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "enabled": { "type": "boolean", "default": true, "description": "User can untick items in the review step." }
  }
}
